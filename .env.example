# ─────────────────────────────────────────────────────────
# Marbefa Poultry - Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this to .env and fill in your values before building/deploying.
#
# ── Frontend (set these before running `npm run build`) ──
# Public path the React app is served from.
#   Domain root:  /
#   Subfolder:    /marbefapoultry/
VITE_BASE=/

# URL of the Django API (must be reachable from the browser).
# Hostinger Python App URL, e.g.: https://api.yourdomain.com
# or a subdirectory: https://yourdomain.com/api
VITE_API_URL=https://yourdomain.com/api

# ── Backend (set in Hostinger Python App "Environment Variables") ──
DJANGO_SECRET_KEY=generate-a-long-random-string-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
DJANGO_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
