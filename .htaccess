# Marbefa Poultry Analytics - Apache configuration
# Serves the built React SPA from /dist with client-side routing fallback.

<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -Indexes

  # Root request → SPA entry point
  RewriteRule ^$ dist/index.html [L]

  # If the request maps to a real file/directory, serve it directly
  # (this serves dist/assets/*, favicon, icons, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → SPA fallback (client-side routing)
  RewriteRule ^ dist/index.html [L]
</IfModule>

# Cache static assets aggressively
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
